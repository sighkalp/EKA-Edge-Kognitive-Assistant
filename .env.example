# EKA Environment Configuration

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eka_db
POSTGRES_DB=eka_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
VECTOR_STORE_TYPE=postgresql
VECTOR_STORE_PATH=postgresql://postgres:postgres@localhost:5432/eka_db

# Optional cloud database deployment
SUPABASE_DATABASE_URL=

# ORM and migrations
SQLALCHEMY_ECHO=false
ALEMBIC_CONFIG=alembic.ini

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:3000

# Vision
YOLO_MODEL=YOLO11n
YOLO_CONFIDENCE_THRESHOLD=0.6
YOLO_MODEL_PATH=

# Activity recognition
ACTIVITY_MODEL=R3D-18
ACTIVITY_CONFIDENCE_THRESHOLD=0.7

# Embeddings
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
PDF_EXTRACTION_BACKEND=pymupdf

# Knowledge assistant
GEMINI_API_KEY=
LLM_MODEL=gemini
LLM_FALLBACK=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-4b-instruct-2507

# Security
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Safety
ENABLE_SAFETY_ENGINE=true
SAFETY_ENGINE_MODE=deterministic

# Testing
PYTEST_ADDOPTS=

# Deployment
DEPLOYMENT_PLATFORM=docker
