# EKA Environment Configuration Example

# Backend API
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=your-secret-key-change-in-production

# Database (Supabase PostgreSQL free tier)
DATABASE_URL=postgresql://user:password@localhost:5432/eka_db
DATABASE_ECHO=false

# AI Models
YOLO_MODEL_PATH=models/weights/yolo5l.pt
ACTIVITY_MODEL_PATH=models/weights/activity_model.pth

# Knowledge Assistant
# Vector Store: PostgreSQL + pgvector (integrated with database above)
VECTOR_STORE_TYPE=postgresql
VECTOR_STORE_PATH=postgresql://user:password@localhost:5432/eka_db

# LLM Configuration
# Primary: Gemini API (free tier)
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini

# Fallback: Local Qwen3-4B (free, no API key needed)
LLM_FALLBACK_MODEL=qwen3-4b-instruct-2507
LLM_FALLBACK_MODE=local
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDINGS_MODEL=all-minilm-l6-v2

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000/api

# Security
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/eka.log

# Feature Flags
ENABLE_SAFETY_ENGINE=true
ENABLE_AUDIT_LOGGING=true
ENABLE_OFFLINE_MODE=true
USE_LLM_FALLBACK=false  # Set to true to use local Qwen3-4B instead of Gemini
